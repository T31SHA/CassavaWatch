# Copy to .env for local development. NEVER commit .env or a real API key.

# Qwen advisory layer (OpenAI-compatible ModelScope endpoint). Leave the key blank to disable.
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen-Ambassador/Qwen3.7-Max
QWEN_TIMEOUT_S=8
# template | llm   (default: template if QWEN_API_KEY is blank, else llm)
ADVISORY_MODE=

# Database (defaults to sqlite:///./cassavawatch.db locally)
# DATABASE_URL=sqlite:///./data/db.sqlite
# Seed synthetic demo reports + alerts on boot when the reports table is empty
SEED_DEMO_DATA=false

# Where scripts/fetch_model.py downloads models/cassava.tflite from, if not present
# MODEL_URL=https://github.com/<owner>/<repo>/releases/download/model-v1/cassava.tflite
